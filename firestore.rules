rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validNickname(nickname) {
      return nickname is string && nickname.matches('^[A-Za-z0-9]{3,15}$');
    }

    function validRarity(rarity) {
      return rarity == null || rarity in ['White', 'Green', 'Blue', 'Purple', 'Gold'];
    }

    function validGameSave(data) {
      return data.keys().hasOnly([
          'version',
          'cardId',
          'currentCount',
          'sparks',
          'completedRounds',
          'requiredClicks',
          'levels',
          'cardRequirements',
          'collection',
          'boosts',
          'consumablePurchases'
        ])
        && data.keys().hasAll([
          'version',
          'cardId',
          'currentCount',
          'sparks',
          'completedRounds',
          'requiredClicks',
          'levels',
          'cardRequirements',
          'collection',
          'boosts',
          'consumablePurchases'
        ])
        && data.version == 1
        && data.cardId is string
        && data.currentCount is int
        && data.currentCount >= 0
        && data.sparks is int
        && data.sparks >= 0
        && data.completedRounds is int
        && data.completedRounds >= 0
        && data.requiredClicks is int
        && data.requiredClicks > 0
        && data.currentCount <= data.requiredClicks
        && data.levels is map
        && data.levels.keys().hasOnly([
          'power',
          'progress',
          'mastery',
          'fortune',
          'critical',
          'auto'
        ])
        && data.levels.keys().hasAll([
          'power',
          'progress',
          'mastery',
          'fortune',
          'critical',
          'auto'
        ])
        && data.levels.power is int
        && data.levels.power >= 0
        && data.levels.progress is int
        && data.levels.progress >= 0
        && data.levels.mastery is int
        && data.levels.mastery >= 0
        && data.levels.fortune is int
        && data.levels.fortune >= 0
        && data.levels.critical is int
        && data.levels.critical >= 0
        && data.levels.auto is int
        && data.levels.auto >= 0
        && data.cardRequirements is map
        && data.cardRequirements.keys().hasOnly([
          'power',
          'progress',
          'mastery',
          'fortune',
          'critical',
          'auto'
        ])
        && data.cardRequirements.keys().hasAll([
          'power',
          'progress',
          'mastery',
          'fortune',
          'critical',
          'auto'
        ])
        && validRarity(data.cardRequirements.power)
        && validRarity(data.cardRequirements.progress)
        && validRarity(data.cardRequirements.mastery)
        && validRarity(data.cardRequirements.fortune)
        && validRarity(data.cardRequirements.critical)
        && validRarity(data.cardRequirements.auto)
        && data.collection is map
        && data.collection.keys().size() <= 60
        && data.boosts is map
        && data.boosts.keys().hasOnly(['sparkClicks', 'focusClicks'])
        && data.boosts.keys().hasAll(['sparkClicks', 'focusClicks'])
        && data.boosts.sparkClicks is int
        && data.boosts.sparkClicks >= 0
        && data.boosts.focusClicks is int
        && data.boosts.focusClicks >= 0
        && data.consumablePurchases is map
        && data.consumablePurchases.keys().hasOnly([
          'spark-tonic',
          'focus-tonic',
          'reveal-dust'
        ])
        && data.consumablePurchases.keys().hasAll([
          'spark-tonic',
          'focus-tonic',
          'reveal-dust'
        ])
        && data.consumablePurchases['spark-tonic'] is int
        && data.consumablePurchases['spark-tonic'] >= 0
        && data.consumablePurchases['focus-tonic'] is int
        && data.consumablePurchases['focus-tonic'] >= 0
        && data.consumablePurchases['reveal-dust'] is int
        && data.consumablePurchases['reveal-dust'] >= 0;
    }

    function validGiftCardId(cardId) {
      return cardId is string
        && cardId.matches('^(00[1-9]|0[1-4][0-9]|050)$');
    }

    function validSpectralGift(data) {
      return data.keys().hasOnly([
          'senderUid',
          'senderNickname',
          'recipientUid',
          'recipientNickname',
          'cardId',
          'createdAt'
        ])
        && data.keys().hasAll([
          'senderUid',
          'senderNickname',
          'recipientUid',
          'recipientNickname',
          'cardId',
          'createdAt'
        ])
        && data.senderUid is string
        && validNickname(data.senderNickname)
        && data.recipientUid is string
        && data.senderUid != data.recipientUid
        && validNickname(data.recipientNickname)
        && validGiftCardId(data.cardId)
        && data.createdAt is timestamp;
    }

    function senderDeductedGiftCard(senderUid, recipientUid, cardId) {
      let senderPath = /databases/$(database)/documents/gameSaves/$(senderUid);
      let previousSave = get(senderPath).data;
      let nextSave = getAfter(senderPath).data;
      let previousCount = previousSave.collection.get(cardId, 0);
      let nextCount = nextSave.collection.get(cardId, 0);
      return senderUid == request.auth.uid
        && senderUid != recipientUid
        && previousCount is int
        && previousCount > 0
        && nextCount is int
        && nextCount == previousCount - 1
        && nextSave.collection.diff(previousSave.collection)
          .affectedKeys().hasOnly([cardId])
        && nextSave.diff(previousSave).affectedKeys().hasOnly(['collection']);
    }

    function recipientReceivedGiftCard(recipientUid, cardId) {
      let recipientPath = /databases/$(database)/documents/gameSaves/$(recipientUid);
      let recipientSaveExists = exists(recipientPath);
      let previousSave = recipientSaveExists ? get(recipientPath).data : null;
      let nextSave = getAfter(recipientPath).data;
      let previousCount = recipientSaveExists
        ? previousSave.collection.get(cardId, 0)
        : 0;
      let nextCount = nextSave.collection.get(cardId, 0);
      return nextCount is int
        && (
          recipientSaveExists
            ? previousCount is int
              && nextCount == previousCount + 1
              && nextSave.collection.diff(previousSave.collection)
                .affectedKeys().hasOnly([cardId])
              && nextSave.diff(previousSave).affectedKeys().hasOnly(['collection'])
            : nextCount == 1
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.keys().hasAll(['nickname'])
        && validNickname(request.resource.data.nickname)
        && getAfter(
          /databases/$(database)/documents/nicknameClaims/$(request.resource.data.nickname.lower())
        ).data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname'])
        && request.resource.data.keys().hasAll(['nickname'])
        && validNickname(request.resource.data.nickname)
        && getAfter(
          /databases/$(database)/documents/nicknameClaims/$(request.resource.data.nickname.lower())
        ).data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /nicknameClaims/{nickname} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && nickname.matches('^[a-z0-9]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nickname.lower() == nickname;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nickname.lower() != nickname;
      allow update: if false;
    }

    match /gameSaves/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validGameSave(request.resource.data);
      allow delete: if false;
    }

    match /spectralGifts/{giftId} {
      allow get: if signedIn()
        && (
          resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        );
      allow list: if signedIn()
        && resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn()
        && validSpectralGift(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.senderUid == request.auth.uid
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.nickname == request.resource.data.senderNickname
        && get(
          /databases/$(database)/documents/nicknameClaims/$(request.resource.data.recipientNickname.lower())
        ).data.uid == request.resource.data.recipientUid
        && senderDeductedGiftCard(
          request.resource.data.senderUid,
          request.resource.data.recipientUid,
          request.resource.data.cardId
        );
      allow update: if false;
      allow delete: if signedIn()
        && validSpectralGift(resource.data)
        && resource.data.recipientUid == request.auth.uid
        && recipientReceivedGiftCard(
          resource.data.recipientUid,
          resource.data.cardId
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
